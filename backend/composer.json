{
  "name": "codex/backend",
  "description": "Project Codex API (PHP 8.2, SQLite)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Codex\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Codex\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php database/migrate.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
