{
  "name": "project-codex",
  "version": "0.2.0",
  "private": true,
  "description": "Project Codex: budget-first life dashboard (web, desktop, Android)",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "release": "node scripts/release.mjs",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test && cd backend && composer test"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/status-bar": "^8.0.2"
  }
}
